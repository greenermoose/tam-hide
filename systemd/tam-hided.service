# Prototype systemd unit for isolated VM testing only (Phase 2b).
# Do NOT install on a live workstation until Phase 2b VM verification completes.

[Unit]
Description=tam-hide whole-seat VT controller (isolated VM only)
Conflicts=getty@tty6.service autovt@tty6.service
After=systemd-logind.service

[Service]
Type=simple
RuntimeDirectory=tam-hide
RuntimeDirectoryMode=0755
StateDirectory=tam-hide
StateDirectoryMode=0700
ExecStart=/usr/local/bin/tam-hided --lock-vt 6 --socket /run/tam-hide/control.sock --auth-socket /run/tam-hide/auth.sock --store /var/lib/tam-hide/passcodes.db
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
